{
  "name": "a22",
  "description": "Angular 22",
  "version": "0.0.0",
  "scripts": {
    "npm": "npm",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "npm run test:ivy-zoned && npm run test:ivy-zoneless",
    "test:ivy-zoned": "npm run test:jasmine:ivy-zoned && npm run test:jest:ivy-zoned",
    "test:ivy-zoneless": "npm run test:jasmine:ivy-zoneless && npm run test:jest:ivy-zoneless",
    "test:debug": "npm run test:jasmine:debug",
    "test:jasmine:ivy-zoned": "ng test --configuration ivy-zoned --progress=false --no-watch",
    "test:jasmine:ivy-zoneless": "ng test --configuration ivy-zoneless --progress=false --no-watch",
    "test:jasmine:debug": "npm run test:jasmine:ivy-zoned -- --watch --browsers Chrome",
    "test:jest:ivy-zoned": "jest --config jest.config.ivy-zoned.ts",
    "test:jest:ivy-zoneless": "jest --config jest.config.ivy-zoneless.ts",
    "test:jest:debug": "jest -i --watch"
  },
  "private": true,
  "dependencies": {
    "@angular/animations": "22.1.1",
    "@angular/common": "22.1.1",
    "@angular/compiler": "22.1.1",
    "@angular/core": "22.1.1",
    "@angular/forms": "22.1.1",
    "@angular/platform-browser": "22.1.1",
    "@angular/platform-browser-dynamic": "22.1.1",
    "@angular/router": "22.1.1",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.2"
  },
  "devDependencies": {
    "@angular/build": "22.1.3",
    "@angular/cli": "22.1.3",
    "@angular/compiler-cli": "22.1.1",
    "@types/jasmine": "6.0.0",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.3",
    "jasmine-core": "6.1.0",
    "jest": "30.4.2",
    "jest-environment-jsdom": "30.4.1",
    "jest-preset-angular": "16.2.0",
    "karma": "6.4.4",
    "karma-chrome-launcher": "3.2.0",
    "karma-coverage": "2.2.1",
    "karma-jasmine": "5.1.0",
    "karma-jasmine-html-reporter": "2.2.0",
    "ng-packagr": "22.1.1",
    "npm": "11.19.0",
    "puppeteer": "25.5.0",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "npm": "11.19.0"
  }
}
