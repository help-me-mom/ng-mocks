{
  "name": "jest",
  "description": "Angular Jest Only",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "npm": "npm",
    "ng": "ng",
    "start": "ng serve",
    "build": "ng build",
    "test": "npm run test:jest && npm run test:jest:esm:ivy-zoned",
    "test:jest": "jest --config jest.config.ts",
    "test:jest:esm:ivy-zoned": "node --experimental-vm-modules ./node_modules/jest/bin/jest.js --config jest.config.esm.ivy-zoned.mjs",
    "test:jest:debug": "jest -i --watch"
  },
  "dependencies": {
    "@angular/animations": "22.1.8",
    "@angular/common": "22.1.8",
    "@angular/compiler": "22.1.8",
    "@angular/core": "22.1.8",
    "@angular/forms": "22.1.8",
    "@angular/platform-browser": "22.1.8",
    "@angular/platform-browser-dynamic": "22.1.8",
    "@angular/router": "22.1.8",
    "rxjs": "7.8.2",
    "tslib": "2.8.1",
    "zone.js": "0.16.3"
  },
  "devDependencies": {
    "@angular/build": "22.1.9",
    "@angular/cli": "22.1.9",
    "@angular/compiler-cli": "22.1.8",
    "@types/jest": "30.0.0",
    "@types/node": "24.13.6",
    "jest": "30.5.2",
    "jest-environment-jsdom": "30.5.2",
    "jest-preset-angular": "17.0.0",
    "ng-packagr": "22.2.1",
    "npm": "12.0.2",
    "ts-node": "10.9.2",
    "typescript": "6.0.3"
  },
  "engines": {
    "npm": "12.0.2"
  }
}
